# Everything here is OPTIONAL. Copy to .env.local only if you want to raise
# limits or turn on paid cutting. .env.local is gitignored.

# ---- optional: raises the free limits ----

# Tavily — web search + full-text extraction.
#
# You do not need this to start. Without it the app runs on Tavily's keyless
# tier, which supports exactly the search and extract calls free mode makes,
# under hourly/daily/monthly caps.
#
# Adding a key (free, no credit card) gets 1,000 credits a month, and the free
# tier is a HARD STOP — it refuses requests rather than billing you. You only
# get charged if you deliberately upgrade to Pay As You Go.
# https://app.tavily.com/home
# TAVILY_API_KEY=

# ---- search limits ----

# Searching is the only thing here with a hard external budget: the free Tavily
# tier is 1,000 credits a month and one search spends about four, so the site
# gets roughly 250 searches a month. Without limits one person exhausts the
# month in an afternoon and everyone else sees errors for three weeks.
#
# The monthly cap is the real budget, set just under the free tier's 250.
# Raise all three in step with whatever plan you are on. Development uses much
# higher limits, so these only bite in production.
# SEARCH_LIMIT_PER_VISITOR=15
# SEARCH_LIMIT_GLOBAL=150
# SEARCH_LIMIT_MONTHLY=220

# ---- trained models ----

# Ranks passages with the retriever and reranker in ml/, and underlines cut
# cards with the highlighter. They ship with the app and run on this machine —
# no key, no download. Without this the app ranks on keywords alone, which is
# worse and works. Set it in deployment too.
# USE_TRAINED_MODELS=1

# ---- feedback storage ----

# Where Cut / Not useful decisions go. Locally they append to
# data/feedback.jsonl and nothing needs setting.
#
# In deployment the filesystem is wiped between requests, so a store is
# required or the clicks are discarded. Provisioning Upstash for Redis through
# Vercel's marketplace sets these two automatically:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.

# A secret of your choosing. Enables GET /api/feedback?export=1 to download
# everything collected, as JSONL, for training. The rows carry what people
# searched for and what they kept, so the export is not public.
# FEEDBACK_EXPORT_TOKEN=

# Set to 0 to turn collection off entirely.
# CARD_CUTTER_COLLECT=1

# ---- optional: paid cutting ----

# Claude. Only for POST /api/cut, which cuts the cards for you instead of
# handing you the passages. Genuinely pay-as-you-go, ~$0.50-1.00 per query.
# Leave blank to stay free.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# The paid path defaults to claude-haiku-4-5, the cheapest tier, since cutting
# is the only place this app spends Claude tokens. Set this to
# claude-sonnet-5 if the judgment turns out to matter more than the saving —
# roughly double the cost per card.
#
# Reading passages does NOT run on Claude and costs no tokens; that is the
# trained reranker in ml/, which runs on this machine.
# CARD_CUTTER_MODEL=claude-sonnet-5

# How many articles each query reads. Default 8. Fewer = fewer Tavily credits,
# and in paid mode proportionally less spend.
# CARD_CUTTER_SOURCE_LIMIT=5
