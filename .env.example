# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Claude — reads the source, picks the warrant, writes the tag and the underline.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Tavily — web search + full-text extraction of the articles we cut from.
# https://app.tavily.com/home
TAVILY_API_KEY=

# Optional overrides (defaults live in src/lib/models.ts)
# CARD_CUTTER_MODEL=claude-opus-5
