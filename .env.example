# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ---- required ----

# Tavily — web search + full-text extraction. This is the only key free mode
# needs. Free tier is enough to use this properly. https://app.tavily.com/home
TAVILY_API_KEY=

# ---- optional: paid cutting ----

# Claude. Only needed for POST /api/cut, which cuts the cards for you.
# Pay-as-you-go, separate from any Claude subscription, ~$0.50-1.00 per query.
# Leave this blank to stay on free mode.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cheaper model for the paid path — roughly 5x less, noticeably worse judgment
# about which passage is the warrant. Fine for checking the plumbing works.
# CARD_CUTTER_MODEL=claude-haiku-4-5

# How many articles each query reads. Default 8. In free mode this only costs
# Tavily credits; in paid mode each source is also a full-length model call.
# CARD_CUTTER_SOURCE_LIMIT=5
